{
  "name": "homematch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "research:refresh": "node --env-file=.env.local scripts/refresh-research.mjs --once",
    "research:watch": "node --env-file=.env.local scripts/refresh-research.mjs --watch",
    "research:status": "node scripts/refresh-research.mjs --status",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "@mapbox/polyline": "^1.2.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "csv-parse": "^7.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.55.0",
    "next": "^16.4.4",
    "proj4": "2.22.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.64.0",
    "@types/leaflet": "^1.9.22",
    "@types/mapbox__polyline": "^1.0.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "axe-core": "4.14.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.4",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
