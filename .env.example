# Explicit read-only preview; never used as an authenticated backend.
APP_MODE=preview
APP_ORIGIN=http://localhost:3000
# Switch APP_MODE to supabase once these are configured and migrations applied.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Use onemap for real address search; fixture mode is development-only in Supabase mode.
LOCATION_MODE=fixtures
ONEMAP_TOKEN=
# Optional registered OneMap credentials for server-side automatic token renewal.
# Keep the password private. Both fields are required to enable renewal.
ONEMAP_EMAIL=
ONEMAP_PASSWORD=
# Single designated worker host; checks hourly and refreshes at most once per interval.
RESEARCH_REFRESH_INTERVAL_HOURS=24
# Optional AI extraction; manual entry works without this key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Enable only after applying the recovery migration and configuring email delivery/template.
PASSWORD_RECOVERY_ENABLED=false
# Enable after the operation_limits migration is applied. Required for production provider requests.
OPERATION_LIMITS_ENABLED=false
# Turn on only after configuring the Apple provider and testing its callback in Supabase.
APPLE_SIGN_IN_ENABLED=false
# URA Data Service key for the separately run private-pricing importer. Not a OneMap token.
URA_ACCESS_KEY=
